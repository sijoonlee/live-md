{
  "name": "live-md-vscode",
  "publisher": "local",
  "displayName": "live-md",
  "description": "Edit live-md documents inside VS Code, alongside an agent working on the same document.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "liveMd.open",
        "title": "live-md: Open"
      },
      {
        "command": "liveMd.reload",
        "title": "live-md: Reload"
      }
    ],
    "configuration": {
      "title": "live-md",
      "properties": {
        "liveMd.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL of the live-md server."
        }
      }
    }
  }
}
