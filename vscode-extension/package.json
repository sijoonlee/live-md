{
  "name": "live-md-vscode",
  "displayName": "live-md",
  "description": "Edit live-md documents inside VS Code, alongside an agent working on the same document.",
  "version": "0.1.0",
  "private": true,
  "engines": {"vscode": "^1.90.0"},
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {"command": "liveMd.open", "title": "live-md: Open"},
      {"command": "liveMd.reload", "title": "live-md: Reload"}
    ],
    "configuration": {
      "title": "live-md",
      "properties": {
        "liveMd.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL of the live-md server."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
