# GitHub OAuth App (M14 part B, human auth). Register at
# https://github.com/settings/developers -> OAuth Apps -> New OAuth App.
# Callback URL must exactly match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback
# Server-generated secret that signs the OAuth state / session. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me
# Comma-separated GitHub logins/emails allowed to sign in (fails closed if empty)
ALLOWED_GITHUB=your-github-login
# Comma-separated GitHub logins/emails granted the global `admin` role (bypasses
# per-document ownership + sharing). Must be a subset of who can sign in. Empty =
# no admins. Keyed on the GitHub login or a verified email.
ADMIN_GITHUB=
